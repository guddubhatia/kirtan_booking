# SSBBN Kirtan Panel — Backend environment
# Copy to `.env` and fill in real values:  cp .env.example .env

# Port the API listens on (Render sets this automatically in production)
PORT=4000

# PostgreSQL connection string.
#   Neon:  postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
#   Local: postgresql://USER:PASSWORD@localhost:5432/DBNAME
DATABASE_URL=

# SSL handling for the DB connection (optional).
#   auto (default) — SSL on, except for localhost/127.0.0.1 hosts
#   require        — force SSL (use if auto-detection guesses wrong)
#   disable        — no SSL (plain local Postgres)
# PGSSL=auto

# Secret used to sign JWTs — set a long random string in production.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long admin tokens stay valid
JWT_TTL=30d

# Initial admin account. Auto-created on first boot (when no admin exists yet)
# and (re)applied by `npm run seed`.
ADMIN_EMAIL=admin@ssbbn.local
ADMIN_PASSWORD=changeme123
